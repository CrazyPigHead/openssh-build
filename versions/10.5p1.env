# =============================================================================
# OpenSSH 构建版本组合与物料校验值
#
# 由 common/common.sh 的 load_version_env() 加载(source)。
# 新增版本步骤:
#   1. 复制本文件为 versions/<版本>.env,更新版本号、RPM_RELEASE/DEB_REVISION;
#   2. 填入新版本各 tarball 的 SHA256(OpenSSH 用 PGP 指纹,指纹一般多年不变,
#      如有轮换需同步更新);
#   3. 确认新 OpenSSL 与 OpenSSH 的兼容性(查上游 CI 矩阵
#      .github/workflows/c-cpp.yml);
#   4. ./build.sh deb --version <版本> 或 ./build.sh rpm --version <版本>。
# =============================================================================

# ---- 上游版本组合 ----
OPENSSH_VER=10.5p1
OPENSSL_VER=4.0.2
ZLIB_VER=1.3.2
CBOR_VER=0.14.0
FIDO2_VER=1.17.0
LIBEDIT_VER=20240808-3.1
# ncurses 仅 rpm 构建使用(EL8 无静态 tinfo,必须自建);deb 用系统 libtinfo.a
NCURSES_VER=6.5

# ---- 打包版本 ----
# deb:完整版本为 ${DEB_EPOCH}:${OPENSSH_VER}-${DEB_REVISION}
#      epoch=1 与 Ubuntu 原生包一致;revision 需高于目标机已装版本才能升级
DEB_EPOCH=1
DEB_REVISION=1local2
# rpm:完整版本为 ${OPENSSH_VER}-${RPM_RELEASE},release 标签对齐目标发行版
RPM_RELEASE=1.ky10

# ---- 源码校验 ----
# OpenSSH 官方发布签名指纹(RELEASE_KEY.asc)
OPENSSH_FP="7168 B983 815A 5EEF 59A4  ADFD 2A3F 414E 7360 60BA"
# 其余依赖 SHA256(与官方发布值一致)
SHA256_openssl=736b467530f916737b7031310ccb21d8218c6229e61e8e160cd1d3458cd543a8
SHA256_zlib=bb329a0a2cd0274d05519d61c667c062e06990d72e125ee2dfa8de64f0119d16
SHA256_cbor=a8c1516e741562cf95aa4479c64916c3d4d2623e24fdc35e414e2320e7300aae
SHA256_fido2=ace062d14a482ff9325410ff63d06c8b5fe87e79ebc18dda07add2bc0188c77f
SHA256_libedit=5f0573349d77c4a48967191cdd6634dd7aa5f6398c6a57fe037cc02696d6099f
SHA256_ncurses=136d91bc269a9a5785e5f9e980bc76ab57428f604ce3e5a5a90cebc767971cc6
