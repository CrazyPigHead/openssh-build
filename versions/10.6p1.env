# =============================================================================
# OpenSSH 构建版本组合与物料校验值
#
# 由 common/common.sh 的 load_version_env() 加载(source)。
# =============================================================================

# ---- 上游版本组合 ----
OPENSSH_VER=10.6p1
OPENSSL_VER=4.0.3
ZLIB_VER=1.3.2
CBOR_VER=0.14.0
FIDO2_VER=1.17.0
LIBEDIT_VER=20260512-3.1
# ncurses 仅 rpm 构建使用(EL8 无静态 tinfo,必须自建);deb 用系统 libtinfo.a
NCURSES_VER=6.6

# ---- 打包版本 ----
# deb:完整版本为 ${DEB_EPOCH}:${OPENSSH_VER}-${DEB_REVISION}
#      epoch=1 与 Ubuntu 原生包一致;revision 需高于目标机已装版本才能升级
DEB_EPOCH=1
DEB_REVISION=1local1
# rpm:完整版本为 ${OPENSSH_VER}-${RPM_RELEASE},release 标签对齐目标发行版
RPM_RELEASE=1.ky10

# ---- 源码校验 ----
# OpenSSH 官方发布签名指纹(RELEASE_KEY.asc),用 PGP 验签,无 SHA256_openssh 变量
OPENSSH_FP="7168 B983 815A 5EEF 59A4  ADFD 2A3F 414E 7360 60BA"
# 其余依赖 SHA256(本地实测)
SHA256_openssl=325b5c806167c13b40b1ffeadfe0248197c00eccc4cf123ec1e28d2d2fd216d9
SHA256_zlib=bb329a0a2cd0274d05519d61c667c062e06990d72e125ee2dfa8de64f0119d16
SHA256_cbor=a8c1516e741562cf95aa4479c64916c3d4d2623e24fdc35e414e2320e7300aae
SHA256_fido2=ace062d14a482ff9325410ff63d06c8b5fe87e79ebc18dda07add2bc0188c77f
SHA256_libedit=432d5e7ea8b0116dd39f2eca7bc11d0eed77faa6b77ea526ace89907c23ea4a0
SHA256_ncurses=355b4cbbed880b0381a04c46617b7656e362585d52e9cf84a67e2009b749ff11
